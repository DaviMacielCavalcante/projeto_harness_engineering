# Saídas de experimentos: PNGs ficam, CSVs/JSONLs/logs grandes não
data/**/*.csv
data/**/*.jsonl
data/**/*.txt
data/**/log.txt
!data/.gitkeep
!data/eval_queries.jsonl

# Corpus de teste: NENHUM PDF é versionado (são documentos de terceiros).
# Cada pessoa coloca um PDF curto em samples/ — default: samples/exemplo.pdf.
# Ver samples/README.md. Corpus completo (~80 PDFs do B3) também fica fora.
samples/corpus/
samples/*.pdf
!samples/.gitkeep
!samples/README.md
!samples/corpus/
!samples/corpus/*.md

