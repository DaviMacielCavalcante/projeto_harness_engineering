# Copia este ficheiro para pc2.tfvars e preenche com os valores reais.
#
# Como obter o IP Tailscale do PC1:
#   No PC1 (Linux): tailscale ip -4
#   Resultado esperado: 100.x.y.z  (rede privada Tailscale, não roteável pela internet)
#
# Como obter o IP Tailscale do PC2:
#   No PC2: tailscale ip -4
#
# A password do RabbitMQ (guest:guest) é o default de desenvolvimento.
# Não expor em produção — alterar via RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS.

host_role     = "worker"
tailscale_pc1 = "100.FILL.ME.IN"
rabbit_url    = "amqp://guest:guest@100.FILL.ME.IN:5672/"
ollama_url    = "http://100.FILL.ME.IN:11434"
qdrant_url    = "http://100.FILL.ME.IN:6333"
redis_url     = "redis://100.FILL.ME.IN:6379/0"
rerank_url    = "http://100.FILL.ME.IN:8081"
image_tag     = "0.1.0-b3"

# Réplicas do ingest-worker-chunk neste host. Default 1.
# Exp 1 (speedup de indexação) varia este valor entre os apply: 1, 2, 4, ...
#   make tf-apply HOST=pc2   # com chunk_worker_count ajustado aqui, ou:
#   terraform -chdir=infra/terraform apply -var-file=envs/pc2.tfvars -var chunk_worker_count=4
chunk_worker_count = 1

# Exp 3 (bônus): aponta a GERAÇÃO do query-worker para o vLLM no PC1. Só depois
# que o PC1 subiu com enable_vllm=true e o vLLM responde em :8002. Os embeddings
# continuam no Ollama (ollama_url acima). Reverta para "ollama" ao terminar.
# inference_backend = "vllm"
# vllm_url          = "http://100.FILL.ME.IN:8002"
