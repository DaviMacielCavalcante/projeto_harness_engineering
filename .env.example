# Variáveis de ambiente do projeto.
#
# Modo 1 (single-host, dev): copie este arquivo para .env.local e deixe os defaults
# (o docker-compose.yml usa DNS interno como rabbitmq, qdrant, redis, ollama).
#
# Modo 2 (distribuído, 3 PCs via Tailscale): copie para .env.distributed e
# preencha com os IPs Tailscale do PC1.

# --- Mensageria ---
# RABBITMQ_URL=amqp://guest:guest@100.x.y.z:5672/

# --- Inferência ---
# OLLAMA_URL=http://100.x.y.z:11434
# GENERATION_MODEL=qwen2.5:7b-instruct
# EMBEDDING_MODEL=nomic-embed-text

# --- Vector DB ---
# QDRANT_URL=http://100.x.y.z:6333
# QDRANT_COLLECTION=se_corpus

# --- Cache ---
# REDIS_URL=redis://100.x.y.z:6379/0

# --- Rerank service ---
# RERANK_URL=http://100.x.y.z:8081

# --- Observabilidade ---
LOG_LEVEL=INFO
SERVICE_NAME=unset
